# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
**/node_modules
*.tsbuildinfo
/test-results/
/playwright-report/
!/.env.example

/firebase-debug.log
/firestore-debug.log
/ui-debug.log
/.firebase/
/functions/lib/
/functions/.env*
/firebase-export-*/

# Reproducible presentation/PDF intermediates; final deliverables stay tracked.
/docs/.build/
/docs/.finalized/

# Python build caches, including the video renderer.
__pycache__/
*.py[cod]

# Narration audio, transcripts, captures, and temporary video renders use /work/.
# /work/ is ignored above. Keep docs/video-source and final docs/deliverables.
